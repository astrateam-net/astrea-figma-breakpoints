{
  "name": "astrea-figma-breakpoints",
  "private": true,
  "packageManager": "bun@1.3.1",
  "engines": {
    "bun": ">=1.3.1"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "format": "biome format --write .",
    "lint": "turbo run lint --",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.10",
    "bun-types": "1.3.4",
    "fflate": "0.8.3",
    "turbo": "2.6.1",
    "typescript": "5.9.3"
  }
}
